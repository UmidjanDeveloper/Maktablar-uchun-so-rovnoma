# ============================================================
#  KELAJAK EGASI — Muhit o'zgaruvchilari (Environment variables)
#  Ushbu faylni ".env" nomi bilan nusxalang va qiymatlarni to'ldiring:
#     cp .env.example .env
# ============================================================

# --- Ma'lumotlar bazasi (PostgreSQL / Supabase) ---
# Supabase: Project Settings -> Database -> Connection string -> URI
# Pgbouncer (pooler, 6543-port) — ilova ishlashi uchun:
DATABASE_URL="postgresql://postgres.xxxxxxxx:PAROL@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# To'g'ridan-to'g'ri ulanish (5432-port) — migratsiya va seed uchun:
DIRECT_URL="postgresql://postgres.xxxxxxxx:PAROL@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# --- Admin panel (Hokimiyat) kirish ma'lumotlari ---
#
#  !!! DIQQAT !!!
#  Quyidagi ikkita qiymat NAMUNA. Ishlab chiqarishga (production)
#  chiqarishdan oldin ALBATTA o'zgartiring.
#
#  Agar o'zgartirilmasa, tizim production rejimida admin panelga
#  kirishni butunlay bloklaydi (503 xatosi) — bu ataylab qilingan
#  himoya, chunki "admin123" bilan chiqarilgan panel bir kunda
#  topiladi va butun tumandagi o'quvchilar ma'lumoti ochilib qoladi.
#
ADMIN_USERNAME="hokimiyat"
# Kamida 12 ta belgi. Yaratish:  openssl rand -base64 24
ADMIN_PASSWORD="ALMASHTIRING-kuchli-parol"

# Sessiya imzo kaliti — kamida 32 ta belgi.
# Yaratish:  openssl rand -base64 32
ADMIN_SESSION_SECRET="ALMASHTIRING-openssl-rand-base64-32-natijasi"

# --- Ilova manzili (ixtiyoriy) ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
